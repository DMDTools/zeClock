{
  "name": "Update docs on source change",
  "description": "After the agent writes to Python source files in zeclock/ or pyproject.toml, reminds the agent to review and update docs/.",
  "version": "1.0.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "zeclock/**/*.py",
      "pyproject.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file in zeclock/ or pyproject.toml was just edited. Check if the change affects the project architecture, structure, or technical stack. If it does, update the relevant docs in docs/ (architecture.md, structure.md, tech.md, plugin_authoring.md). Only update for meaningful changes (new module, changed protocol, removed dependency, restructured components). All docs MUST be in English."
  }
}
