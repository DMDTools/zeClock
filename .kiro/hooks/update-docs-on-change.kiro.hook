{
  "enabled": true,
  "name": "Update docs on source change",
  "description": "When Python source files in the zeclock/ package are edited, reminds the agent to review and update the docs/ folder (architecture.md, structure.md, tech.md) to reflect any architectural, structural, or technical changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "zeclock/*.py",
      "zeclock/**/*.py",
      "pyproject.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file in the zeclock/ package or pyproject.toml was just edited. Check if the change affects the project's architecture, structure, or technical stack. If it does, update the relevant documentation files in docs/ (architecture.md, structure.md, tech.md) to stay in sync with the code. All documentation MUST be written in English. Only update docs if there is a meaningful change (new module, changed protocol, new dependency, restructured components). Minor bug fixes or logic tweaks do not require doc updates."
  }
}