[Unit]
Description=zeClock OTA - Re-apply cached update after reboot (overlay FS reset)
After=network-online.target bind-persistent-dirs.service
Wants=network-online.target
Requires=bind-persistent-dirs.service
Before=zeclock.service

[Service]
Type=oneshot
User=root
Environment=PATH=/home/zeclock/venv/bin:/usr/local/bin:/usr/bin
Environment=LD_LIBRARY_PATH=/home/zeclock/.zeclock/lib
Environment=ZECLOCK_DATA_DIR=/data/zeclock
WorkingDirectory=/home/zeclock/app
ExecStart=/home/zeclock/venv/bin/python -m zeclock.updater --apply-cached
TimeoutStartSec=120
RemainAfterExit=yes
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zeclock-update

[Install]
WantedBy=multi-user.target
